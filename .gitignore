# =====================================================================
# RetainNet — Official .gitignore
# =====================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing and coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Streamlit local runtime state
.streamlit/secrets.toml

# Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# =====================================================================
# Internal AI Agent Framework & Execution Metadata (Excluded from Public Git)
# =====================================================================
.agents/
agents/
.agent/
.gsd/
.gemini/
adapters/
scripts/
GSD-STYLE.md
PROJECT_RULES.md
model_capabilities.yaml
VERSION
